# Open-source-friendly .gitignore (DLV-CD / DINOv3 change detection)

# --- OS / editors ---
.DS_Store
Thumbs.db

.idea/
.vscode/
*.iml

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Environments ---
.env
.home/
.venv/
venv/
env/

# --- Build artifacts ---
build/
dist/
*.egg-info/

# --- Data / outputs (do not publish) ---
data/
outputs/
pretrained_weights/
runs/
wandb/
baselines/

# --- Model weights / large artifacts (use Git LFS or download scripts) ---
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Local DINO backbone folders (often >100MB)
dinov3-*/
dinov3-vit*/

# Prototypes / cached stats
prototypes*.npy

# Accidental legacy file created during README cleanup
README_SAM_DISTILLATION_OLD.md
